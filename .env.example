# ─────────────────────────────────────────────────────────────────────────────
# AgentOps Debugger — environment variables (placeholders only; never commit real keys)
# Copy to .env and fill in. See docs/VERIFY.md for items to confirm at build time.
# ─────────────────────────────────────────────────────────────────────────────

# --- Qwen Cloud / DashScope (OpenAI-compatible) ---  [VERIFY B-1]
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# Optional stronger reasoning model for the Coordinator (if in credits)
QWEN_PLANNER_MODEL=qwen-max
# Embeddings model (if available in credits; else lexical fallback)  [VERIFY B-4]
QWEN_EMBEDDING_MODEL=text-embedding-v3

# --- OEFA Datos Abiertos (Junar) ---  [VERIFY B-2]
# Issued from https://datosabiertos.oefa.gob.pe/developers/
OEFA_API_KEY=your-junar-auth-key
OEFA_API_BASE_URL=http://api.datosabiertos.oefa.gob.pe/api/v2

# --- Alibaba Cloud Tablestore (OTS) ---
TABLESTORE_ENDPOINT=https://your-instance.region.ots.aliyuncs.com
TABLESTORE_INSTANCE=your-instance-name
TABLESTORE_ACCESS_KEY_ID=your-access-key-id
TABLESTORE_ACCESS_KEY_SECRET=your-access-key-secret

# --- Alibaba Cloud OSS (object storage) ---
OSS_REGION=oss-ap-southeast-1
OSS_BUCKET=agentops-debugger
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# --- Server ---
PORT=8787
NODE_ENV=development

# --- Edge hardening (expensive endpoints) ---
# Per-IP rate limit (requests/minute) on /agent/* and /rag/retrieve. 0 disables
# it (the default — keeps offline/dev frictionless). Set e.g. 60 on a public deploy.
RATE_LIMIT_PER_MIN=0
# Max request body size in bytes for those POST endpoints (default 32768 = 32 KB).
BODY_LIMIT_BYTES=32768
# Optional shared secret gating the deployed demo. When set, API routes require a
# `demo_token` cookie obtained via /unlock?token=<this value>. Unset = open (default).
DEMO_ACCESS_TOKEN=
